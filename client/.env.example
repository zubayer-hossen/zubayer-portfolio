# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production either keep '/api/v1' and proxy via netlify.toml / vercel.json,
# or set the full backend URL, e.g. https://your-api.onrender.com/api/v1
VITE_API_URL=/api/v1
# Public URL of the frontend (used for canonical links and structured data)
VITE_SITE_URL=http://localhost:5173

