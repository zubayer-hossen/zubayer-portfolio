# ---------- Server ----------
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
# Comma separated list allowed. The first one is the canonical public site URL.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local:  mongodb://127.0.0.1:27017/zubayer-portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zubayer-portfolio
MONGO_URI=mongodb://127.0.0.1:27017/zubayer-portfolio

# ---------- Auth (generate long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# lax  -> frontend proxies /api to backend (recommended, see client/netlify.toml)
# none -> frontend calls backend on a different domain directly (needs HTTPS)
COOKIE_SAMESITE=lax
IP_HASH_SALT=change-me-salt

# ---------- Cloudinary (optional in development: falls back to local /uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- First admin (used only by `npm run seed`) ----------
ADMIN_NAME=Zubayer Hossen
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword#2026

# ---------- Optional ----------
# Raises GitHub API rate limit for repository sync
GITHUB_TOKEN=
